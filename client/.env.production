# Public build-time configuration for the deployed Render frontend.
# These URLs contain no secrets and are intentionally committed.
VITE_API_BASE=https://ms-sushant-construction.onrender.com/api
VITE_UPLOADS_BASE=https://ms-sushant-construction.onrender.com/uploads
# Public Android APK URL is intentionally supplied by Render at build time.
# Do not define a blank fallback here: Vite embeds VITE_* values in the static
# production bundle, so an empty local value would leave the CTA disabled.
