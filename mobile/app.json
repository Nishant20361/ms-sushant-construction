{
  "expo": {
    "name": "MS Sushant Construction",
    "slug": "ms-sushant-construction",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mssushantconstruction",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.mssushantconstruction.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mssushantconstruction.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b4745a67-af53-45ad-9e93-fabf550413f6"
      }
    },
    "owner": "nishant20361"
  }
}
