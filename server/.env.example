# ------------------------------------------------------------------
# Example server environment — copy to `.env` (local dev) or `.env.test`.
# ------------------------------------------------------------------

# --- Database ---
# Local development (PostgreSQL):
DATABASE_URL="postgresql://USER@localhost:5432/ms_sushant_dev?schema=public"

# Tests — put in server/.env.test:
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/ms_sushant_test?schema=public"
# DATABASE_URL="postgresql://USER@localhost:5432/ms_sushant_test?schema=public"
# NODE_ENV=test

# Production (Render) — injected by Render, do NOT commit:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"

# Public URL of the frontend. Password-reset links are sent here.
# Production must use your actual HTTPS website, for example:
# CLIENT_URL="https://www.example.com"
CLIENT_URL="http://localhost:5173"

# --- Deployment ---
# Enable only when a trusted reverse proxy overwrites X-Forwarded-* headers.
TRUST_PROXY=false
