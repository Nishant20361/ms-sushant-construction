{
  "expo": {
    "name": "Sushant Control",
    "slug": "sushant-control",
    "version": "1.0.5",
    "orientation": "portrait",
    "scheme": "sushantcontrol",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.mssushantconstruction.admin",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mssushantconstruction.admin",
      "versionCode": 7,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#075E46"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#075E46",
          "defaultChannel": "general"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#075E46",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D1512"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sushant Control to choose a product or category image only when you request it.",
          "cameraPermission": "Allow Sushant Control to take a product or category photo only when you request it.",
          "microphonePermission": "Allow Sushant Control to transcribe your admin request when you tap Voice."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sushant Control to transcribe your admin request when you tap Voice.",
          "speechRecognitionPermission": "Allow Sushant Control to convert your spoken admin request to editable text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c351bcea-0517-4c18-9278-c83ece52e0e1"
      }
    },
    "owner": "nishant20361"
  }
}
