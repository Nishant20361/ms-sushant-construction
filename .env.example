# ------------------------------------------------------------------
# Example environment — copy to `.env` and fill in your values.
# ------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development            # development | production | test
PORT=5100
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local development (PostgreSQL):
DATABASE_URL="postgresql://USER@localhost:5432/ms_sushant_dev?schema=public"

# Tests (see server/.env.test):
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/ms_sushant_test?schema=public"

# Production (Render) — injected by Render, do NOT commit:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
COOKIE_DOMAIN=

# --- Initial admin (used by db:seed / db:reset-admin) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD="at-least-12-characters"
INITIAL_ADMIN_EMAIL=admin@example.com

# --- Render production values (set these in the Render dashboard, not here) ---
# Backend service:
# NODE_ENV=production
# CLIENT_URL=https://ms-sushant-construction-1.onrender.com
# TRUST_PROXY=true
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM=your-brevo-verified-sender@example.com
#
# Frontend build:
# VITE_API_BASE=https://ms-sushant-construction.onrender.com/api
# VITE_UPLOADS_BASE=https://ms-sushant-construction.onrender.com/uploads
