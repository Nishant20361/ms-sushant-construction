# ============================================================
# M/S SUSHANT CONSTRUCTION - environment variables (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# Node environment: development | production
NODE_ENV=development

# Backend port
PORT=5000

# Absolute or relative URL of the frontend (used for CORS allowlist)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------
# Database
# -----------------------------------------------
# SQLite (development / local): file is stored in server/prisma/dev.db
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL, switch Prisma provider to "postgresql"
# and use a connection string like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# -----------------------------------------------
# Auth / Security
# -----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# -----------------------------------------------
# Initial admin (created by `npm run db:seed` / setup script)
# Password MUST be at least 12 characters.
# -----------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Nishant_Kumar
INITIAL_ADMIN_EMAIL=admin@example.com

