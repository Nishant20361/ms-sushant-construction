# ============================================================
# M/S SUSHANT CONSTRUCTION - environment variables (example)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# Node environment: development | production
NODE_ENV=development

# Backend port
PORT=5000

# Absolute or relative URL of the frontend (used for CORS allowlist)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------
# Database
# -----------------------------------------------
# Local development uses SQLite by default.
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL, change `provider = "sqlite"` to
# `provider = "postgresql"` in server/prisma/schema.prisma and set
# DATABASE_URL="******host:5432/dbname?schema=public"
JWT_SECRET=change-me-to-a-long-random-secret

# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# -----------------------------------------------
# Initial admin (created by `npm run db:seed` / setup script)
# Password MUST be at least 12 characters.
# You can also use ADMIN_USERNAME / ADMIN_PASSWORD / ADMIN_EMAIL.
# -----------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Nishant_Kumar
INITIAL_ADMIN_EMAIL=admin@example.com

